{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "mode": { "enum": ["change", "initial"] },
    "origin": { "enum": ["ai", "human", "mixed", "unknown"] },
    "focus": { "enum": ["general", "functional", "security", "data", "architecture", "initial", "ai", "all"] },
    "securityAlways": { "type": "boolean" },
    "includeDiff": { "type": "boolean" },
    "maxDiffBytes": { "type": "integer", "minimum": 1000 },
    "exclude": { "type": "array", "items": { "type": "string" } },
    "modules": { "type": "object", "additionalProperties": false, "properties": { "enable": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2}$" }, "uniqueItems": true }, "disable": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2}$" }, "uniqueItems": true } } }
  },
  "additionalProperties": false
}
